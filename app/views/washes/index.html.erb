<% content_for :title, "#{t('washes.index.title')} — MoykaGo" %>
<section class="section page-head">
  <div class="container">
    <h1><%= t("washes.index.title") %><% if @district %> — <%= @district %><% end %></h1>
    <%= form_with url: washes_path, method: :get, class: "filters", data: {
          controller: "geolocation", geolocation_target: "form",
          geolocation_locating_value: t("washes.index.locating"),
          geolocation_unsupported_value: t("washes.index.geolocation_unsupported"),
          geolocation_denied_value: t("washes.index.geolocation_denied")
        } do %>
      <select name="district" onchange="this.form.requestSubmit()" aria-label="<%= t('home.all_districts') %>">
        <option value=""><%= t("home.all_districts") %></option>
        <% Wash::DISTRICTS.each do |d| %>
          <option value="<%= d %>" <%= "selected" if @district == d %>><%= d %></option>
        <% end %>
      </select>
      <select name="wash_type" onchange="this.form.requestSubmit()" aria-label="<%= t('washes.index.type_label') %>">
        <option value=""><%= t("wash_types.all") %></option>
        <% Wash::WASH_TYPES.each do |wt| %>
          <option value="<%= wt %>" <%= "selected" if @wash_type == wt %>><%= t("wash_types.#{wt}") %></option>
        <% end %>
      </select>
      <select name="sort" onchange="this.form.requestSubmit()" aria-label="<%= t('washes.index.sort_label') %>">
        <option value=""><%= t("washes.index.sort_label") %></option>
        <option value="narx" <%= "selected" if params[:sort] == "narx" %>><%= t("washes.index.sort_cheapest") %></option>
        <option value="reyting" <%= "selected" if params[:sort] == "reyting" %>><%= t("washes.index.sort_rating") %></option>
        <option value="eng_yaqin" <%= "selected" if params[:sort] == "eng_yaqin" %>><%= t("washes.index.sort_nearest") %></option>
      </select>
      <input type="hidden" name="lat" value="<%= @lat %>" data-geolocation-target="lat">
      <input type="hidden" name="lng" value="<%= @lng %>" data-geolocation-target="lng">
      <button type="button" class="btn btn--ghost btn--sm" data-action="geolocation#locate"><%= t("washes.index.locate_me") %></button>
      <span class="hint" data-geolocation-target="status"></span>
    <% end %>
  </div>
</section>

<% washes_with_coords = @washes.select { |w| w.latitude.present? && w.longitude.present? } %>
<% if washes_with_coords.any? %>
  <section class="section">
    <div class="container">
      <div data-controller="map"
           data-map-markers-value="<%= washes_with_coords.map { |w| { lat: w.latitude, lng: w.longitude, name: w.name, url: wash_path(w) } }.to_json %>"
           style="height:320px;border-radius:14px;overflow:hidden"></div>
    </div>
  </section>
<% end %>

<section class="section">
  <div class="container">
    <% if @washes.any? %>
      <div class="cards">
        <%= render partial: "washes/card", collection: @washes, as: :wash, locals: { lat: @lat, lng: @lng } %>
      </div>
    <% else %>
      <div class="empty">
        <p><%= t("washes.index.empty") %></p>
        <%= link_to t("washes.index.see_all"), washes_path, class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>
</section>
