<% content_for :title, "#{@wash.name} — MoykaGo" %>
<section class="section page-head">
  <div class="container">
    <p class="crumbs"><%= link_to t("nav.washes"), washes_path %> / <%= @wash.district %></p>
    <% unless @wash.full_service? %>
      <span class="badge badge--<%= @wash.wash_type %>"><%= t("wash_types.#{@wash.wash_type}") %></span>
    <% end %>
    <h1><%= @wash.name %></h1>
    <div class="wash-meta">
      <%= droplets(@wash.rating, count: @wash.reviews.size) %>
      <span>·</span>
      <span><%= @wash.work_hours %></span>
      <span>·</span>
      <span><%= @wash.bays %> <%= t("washes.show.bays") %></span>
    </div>
    <p class="wash-address"><svg class="mini-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg> <%= @wash.address %> &nbsp;
      <a href="https://yandex.uz/maps/?text=<%= u("#{@wash.name} #{@wash.address} Toshkent") %>" target="_blank" rel="noopener"><%= t("washes.show.map_open") %></a>
    </p>
    <% if @wash.phone.present? %>
      <p class="wash-address"><svg class="mini-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg> <a href="tel:<%= @wash.phone %>"><%= @wash.phone %></a></p>
    <% end %>
    <% if @wash.description.present? %>
      <p class="wash-desc"><%= @wash.description %></p>
    <% end %>
    <% if @wash.photos.attached? %>
      <div class="chips">
        <% @wash.photos.each do |photo| %>
          <%= image_tag photo, style: "height:110px;border-radius:10px;object-fit:cover" %>
        <% end %>
      </div>
    <% end %>
    <% if @wash.latitude.present? && @wash.longitude.present? %>
      <div data-controller="map"
           data-map-markers-value="<%= [ { lat: @wash.latitude, lng: @wash.longitude, name: @wash.name } ].to_json %>"
           data-map-zoom-value="15"
           style="height:220px;border-radius:14px;overflow:hidden;margin-top:14px"></div>
    <% end %>
  </div>
</section>

<section class="section" id="bron">
  <div class="container">
    <h2 class="section__title"><%= t("washes.show.book_title") %></h2>
    <%= form_with model: @booking, url: bookings_path, class: "book-form" do |f| %>
      <%= f.hidden_field :wash_id, value: @wash.id %>

      <fieldset class="book-form__block">
        <legend><%= t("washes.show.step1") %></legend>
        <div class="service-list">
          <% @wash.services.order(:price).each do |s| %>
            <label class="service-opt">
              <%= f.radio_button :service_id, s.id, required: true %>
              <% if s.photo.attached? %><%= image_tag s.photo, style: "width:36px;height:36px;border-radius:8px;object-fit:cover" %><% end %>
              <span class="service-opt__body">
                <span class="service-opt__name"><%= s.name %></span>
                <span class="service-opt__info"><%= s.duration_minutes %> <%= t("washes.show.minutes") %></span>
              </span>
              <span class="service-opt__price"><%= som(s.price) %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="book-form__block">
        <legend><%= t("washes.show.step2") %></legend>
        <div class="date-row">
          <% (0..6).each do |i| %>
            <% d = Date.current + i %>
            <%= link_to wash_path(@wash, date: d, anchor: "bron"),
                  class: "date-pill #{'date-pill--on' if d == @date}" do %>
              <span class="date-pill__dow"><%= I18n.t("date.abbr_day_names")[d.wday] %></span>
              <span class="date-pill__d"><%= d.day %></span>
            <% end %>
          <% end %>
        </div>
        <%= f.hidden_field :date, value: @date %>
        <div class="slot-grid">
          <% @wash.slots.each do |slot| %>
            <% taken = @wash.slot_taken?(@date, slot) %>
            <% past = @wash.slot_past?(@date, slot) %>
            <label class="slot <%= 'slot--off' if taken || past %>">
              <%= f.radio_button :slot, slot, disabled: taken || past, required: true %>
              <span><%= slot %></span>
            </label>
          <% end %>
        </div>
        <p class="hint"><%= t("washes.show.gray_hint") %></p>
      </fieldset>

      <fieldset class="book-form__block">
        <legend><%= t("washes.show.step3") %></legend>
        <div class="form-grid">
          <label><%= t("washes.show.your_name") %>
            <%= f.text_field :customer_name, required: true, placeholder: "Aziz", value: f.object.customer_name || current_customer&.name %>
          </label>
          <label><%= t("washes.show.phone") %>
            <%= f.telephone_field :customer_phone, required: true, placeholder: "+998 90 123 45 67", value: f.object.customer_phone || current_customer&.phone %>
          </label>
          <% if current_customer&.cars&.any? %>
            <label><%= t("washes.show.car_select") %>
              <%= f.select :car_id, current_customer.cars.map { |c| [ c.label, c.id ] }, include_blank: t("washes.show.car_other") %>
            </label>
          <% end %>
          <label><%= t("washes.show.car_optional") %>
            <%= f.text_field :car_model, placeholder: "Cobalt, oq" %>
          </label>
          <label><%= t("washes.show.promo_optional") %>
            <%= f.text_field :promo_code, placeholder: "MOYKA10" %>
          </label>
        </div>
        <% if current_customer && current_customer.bonus_balance.positive? %>
          <label class="check-label">
            <%= f.check_box :use_bonus %> <%= t("washes.show.use_bonus") %> (<%= som(current_customer.bonus_balance) %> <%= t("washes.show.available") %>)
          </label>
        <% end %>
      </fieldset>

      <button type="submit" class="btn btn--accent btn--big"><%= t("washes.show.submit") %></button>
      <p class="hint"><%= t("washes.show.pay_note") %></p>
    <% end %>
  </div>
</section>

<section class="section section--tint" id="sharhlar">
  <div class="container">
    <h2 class="section__title"><%= t("washes.show.reviews_title") %></h2>
    <% if @wash.reviews.any? %>
      <div class="reviews">
        <% @wash.reviews.order(created_at: :desc).limit(20).each do |r| %>
          <div class="review">
            <div class="review__head">
              <strong><%= r.name %></strong>
              <%= droplets(r.rating) %>
            </div>
            <% if r.comment.present? %><p><%= r.comment %></p><% end %>
            <% if r.before_photo.attached? || r.after_photo.attached? %>
              <div class="review__photos">
                <% if r.before_photo.attached? %><%= image_tag r.before_photo, style: "height:90px;border-radius:8px" %><% end %>
                <% if r.after_photo.attached? %><%= image_tag r.after_photo, style: "height:90px;border-radius:8px" %><% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="empty-note"><%= t("washes.show.no_reviews") %></p>
    <% end %>

    <details class="review-form-wrap">
      <summary class="btn btn--ghost"><%= t("washes.show.leave_review") %></summary>
      <%= form_with model: Review.new, url: reviews_path, class: "review-form", multipart: true do |f| %>
        <%= f.hidden_field :wash_id, value: @wash.id %>
        <div class="form-grid">
          <label><%= t("washes.show.your_name") %> <%= f.text_field :name, required: true %></label>
          <label><%= t("washes.show.your_rating") %>
            <%= f.select :rating, t("washes.show.rating_options") %>
          </label>
        </div>
        <label><%= t("washes.show.comment") %> <%= f.text_area :comment, rows: 3 %></label>
        <div class="form-grid">
          <label><%= t("washes.show.before_photo") %> <%= f.file_field :before_photo, accept: "image/*" %></label>
          <label><%= t("washes.show.after_photo") %> <%= f.file_field :after_photo, accept: "image/*" %></label>
        </div>
        <button type="submit" class="btn btn--primary"><%= t("washes.show.send") %></button>
      <% end %>
    </details>
  </div>
</section>
