<% content_for :title, "#{@wash.name} — MoykaGo" %>
<section class="section page-head">
  <div class="container">
    <p class="crumbs"><%= link_to "Moykalar", washes_path %> / <%= @wash.district %></p>
    <h1><%= @wash.name %></h1>
    <div class="wash-meta">
      <%= droplets(@wash.rating, count: @wash.reviews.size) %>
      <span>·</span>
      <span><%= @wash.work_hours %></span>
      <span>·</span>
      <span><%= @wash.bays %> post</span>
    </div>
    <p class="wash-address"><svg class="mini-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg> <%= @wash.address %> &nbsp;
      <a href="https://yandex.uz/maps/?text=<%= u("#{@wash.name} #{@wash.address} Toshkent") %>" target="_blank" rel="noopener">xaritada ochish</a>
    </p>
    <% if @wash.phone.present? %>
      <p class="wash-address"><svg class="mini-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg> <a href="tel:<%= @wash.phone %>"><%= @wash.phone %></a></p>
    <% end %>
    <% if @wash.description.present? %>
      <p class="wash-desc"><%= @wash.description %></p>
    <% end %>
  </div>
</section>

<section class="section" id="bron">
  <div class="container">
    <h2 class="section__title">Bron qilish</h2>
    <%= form_with model: @booking, url: bookings_path, class: "book-form" do |f| %>
      <%= f.hidden_field :wash_id, value: @wash.id %>

      <fieldset class="book-form__block">
        <legend>1. Xizmatni tanlang</legend>
        <div class="service-list">
          <% @wash.services.order(:price).each do |s| %>
            <label class="service-opt">
              <%= f.radio_button :service_id, s.id, required: true %>
              <span class="service-opt__body">
                <span class="service-opt__name"><%= s.name %></span>
                <span class="service-opt__info"><%= s.duration_minutes %> daqiqa</span>
              </span>
              <span class="service-opt__price"><%= som(s.price) %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="book-form__block">
        <legend>2. Sana va vaqt</legend>
        <div class="date-row">
          <% (0..6).each do |i| %>
            <% d = Date.current + i %>
            <%= link_to wash_path(@wash, date: d, anchor: "bron"),
                  class: "date-pill #{'date-pill--on' if d == @date}" do %>
              <span class="date-pill__dow"><%= %w[Yak Du Se Chor Pay Ju Shan][d.wday] %></span>
              <span class="date-pill__d"><%= d.day %></span>
            <% end %>
          <% end %>
        </div>
        <%= f.hidden_field :date, value: @date %>
        <div class="slot-grid">
          <% @wash.slots.each do |slot| %>
            <% taken = @wash.slot_taken?(@date, slot) %>
            <% past = @wash.slot_past?(@date, slot) %>
            <label class="slot <%= 'slot--off' if taken || past %>">
              <%= f.radio_button :slot, slot, disabled: taken || past, required: true %>
              <span><%= slot %></span>
            </label>
          <% end %>
        </div>
        <p class="hint">Kulrang vaqtlar band yoki o'tib ketgan.</p>
      </fieldset>

      <fieldset class="book-form__block">
        <legend>3. Ma'lumotlaringiz</legend>
        <div class="form-grid">
          <label>Ismingiz
            <%= f.text_field :customer_name, required: true, placeholder: "Aziz", value: f.object.customer_name || current_customer&.name %>
          </label>
          <label>Telefon
            <%= f.telephone_field :customer_phone, required: true, placeholder: "+998 90 123 45 67", value: f.object.customer_phone || current_customer&.phone %>
          </label>
          <% if current_customer&.cars&.any? %>
            <label>Mashina
              <%= f.select :car_id, current_customer.cars.map { |c| [ c.label, c.id ] }, include_blank: "Boshqa (quyida yozing)" %>
            </label>
          <% end %>
          <label>Mashina (ixtiyoriy)
            <%= f.text_field :car_model, placeholder: "Cobalt, oq" %>
          </label>
        </div>
      </fieldset>

      <button type="submit" class="btn btn--accent btn--big">Bron qilish</button>
      <p class="hint">To'lov joyida — naqd yoki karta. Bron bepul.</p>
    <% end %>
  </div>
</section>

<section class="section section--tint" id="sharhlar">
  <div class="container">
    <h2 class="section__title">Sharhlar</h2>
    <% if @wash.reviews.any? %>
      <div class="reviews">
        <% @wash.reviews.order(created_at: :desc).limit(20).each do |r| %>
          <div class="review">
            <div class="review__head">
              <strong><%= r.name %></strong>
              <%= droplets(r.rating) %>
            </div>
            <% if r.comment.present? %><p><%= r.comment %></p><% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="empty-note">Hali sharh yo'q — birinchi bo'ling!</p>
    <% end %>

    <details class="review-form-wrap">
      <summary class="btn btn--ghost">Sharh qoldirish</summary>
      <%= form_with model: Review.new, url: reviews_path, class: "review-form" do |f| %>
        <%= f.hidden_field :wash_id, value: @wash.id %>
        <div class="form-grid">
          <label>Ismingiz <%= f.text_field :name, required: true %></label>
          <label>Baho (1–5)
            <%= f.select :rating, [["5 — Zo'r", 5], ["4 — Yaxshi", 4], ["3 — O'rtacha", 3], ["2 — Yomon", 2], ["1 — Juda yomon", 1]] %>
          </label>
        </div>
        <label>Izoh <%= f.text_area :comment, rows: 3 %></label>
        <button type="submit" class="btn btn--primary">Yuborish</button>
      <% end %>
    </details>
  </div>
</section>
