<%= link_to wash_path(wash), class: "card" do %>
  <div class="card__visual" data-hue="<%= wash.id % 4 %>">
    <% if wash.photos.attached? %>
      <%= image_tag wash.photos.first, class: "card__photo" %>
    <% else %>
      <span class="card__initial"><%= wash.name.first %></span>
    <% end %>
  </div>
  <div class="card__body">
    <h3 class="card__name"><%= wash.name %></h3>
    <p class="card__meta"><%= wash.district %> · <%= wash.work_hours %></p>
    <div class="card__foot">
      <%= droplets(wash.rating, count: wash.reviews.size) %>
      <span class="card__price"><%= wash.price_from ? t("common.price_from", price: som(wash.price_from)) : "" %></span>
    </div>
    <% if (defined?(lat) && lat.present?) && (dist = wash.distance_km_from(lat, lng)) %>
      <p class="card__meta">📍 <%= dist.round(1) %> km</p>
    <% end %>
  </div>
<% end %>
