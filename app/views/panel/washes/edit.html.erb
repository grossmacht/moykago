<% content_for :title, "Moyka ma'lumotlari — Panel" %>
<section class="section">
  <div class="container container--narrow">
    <%= render "panel/nav" %>
    <h1>Moyka ma'lumotlari</h1>
    <%= form_with model: @wash, url: panel_wash_path, class: "login-form" do |f| %>
      <label>Nomi <%= f.text_field :name, required: true %></label>
      <label>Tuman
        <%= f.select :district, Wash::DISTRICTS %>
      </label>
      <label>Manzil <%= f.text_field :address, required: true %></label>
      <div class="form-grid">
        <label>Kenglik (latitude) <%= f.text_field :latitude, placeholder: "41.2995" %></label>
        <label>Uzunlik (longitude) <%= f.text_field :longitude, placeholder: "69.2401" %></label>
      </div>
      <p class="hint">Google/Yandex xaritada joyingizni topib, koordinatani shu yerga kiriting.</p>
      <label>Telefon <%= f.telephone_field :phone %></label>
      <label>Tavsif <%= f.text_area :description, rows: 3 %></label>
      <div class="form-grid form-grid--3">
        <label>Ochilish (soat) <%= f.number_field :open_hour, min: 0, max: 23 %></label>
        <label>Yopilish (soat) <%= f.number_field :close_hour, min: 1, max: 24 %></label>
        <label>Postlar soni <%= f.number_field :bays, min: 1, max: 20 %></label>
      </div>
      <button type="submit" class="btn btn--primary">Saqlash</button>
    <% end %>

    <h2 class="section__title">Rasmlar</h2>
    <% if @wash.photos.any? %>
      <div class="chips">
        <% @wash.photos.each do |photo| %>
          <span class="chip">
            <%= image_tag photo, style: "height:60px;border-radius:8px;vertical-align:middle" %>
            <%= button_to "✕", panel_wash_photo_path(photo), method: :delete, class: "linklike",
                  data: { turbo_confirm: "Rasm o'chirilsinmi?" } %>
          </span>
        <% end %>
      </div>
    <% else %>
      <p class="empty-note">Hali rasm yuklanmagan.</p>
    <% end %>
    <%= form_with url: panel_wash_photos_path, method: :post, class: "login-form", multipart: true do %>
      <label>Yangi rasm(lar) <input type="file" name="photos[]" multiple accept="image/*"></label>
      <button type="submit" class="btn btn--ghost">Yuklash</button>
    <% end %>
  </div>
</section>
