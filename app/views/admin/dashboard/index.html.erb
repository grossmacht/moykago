<% content_for :title, "Admin — MoykaGo" %>
<section class="section">
  <div class="container">
    <%= render "admin/nav" %>
    <h1>Ko'rsatkichlar</h1>

    <div class="stats">
      <div class="stat"><p class="stat__n"><%= @wash_count %></p><p class="stat__l">Faol moykalar</p></div>
      <div class="stat"><p class="stat__n"><%= @today_count %></p><p class="stat__l">Bugungi bronlar</p></div>
      <div class="stat"><p class="stat__n"><%= @month_count %></p><p class="stat__l">Shu oy bronlar</p></div>
      <div class="stat"><p class="stat__n"><%= som(@month_gmv) %></p><p class="stat__l">Shu oy GMV (bajarilgan)</p></div>
      <div class="stat"><p class="stat__n"><%= som(@month_commission) %></p><p class="stat__l">Shu oy komissiya</p></div>
    </div>
    <p class="hint">GMV va komissiya faqat "bajarildi" deb belgilangan bronlar bo'yicha hisoblanadi (moyka egasi to'lov usulini kiritganda).</p>

    <% if @by_wash.any? %>
      <h2 class="section__title">Moykalar bo'yicha (shu oy)</h2>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Moyka</th><th>Bronlar soni</th><th>GMV</th><th>Komissiya</th></tr></thead>
          <tbody>
            <% month = Date.current.beginning_of_month..Date.current.end_of_month %>
            <% @by_wash.each do |wash, count| %>
              <tr>
                <td><%= wash.name %></td>
                <td><%= count %></td>
                <td><%= som(wash.gmv_between(month)) %></td>
                <td><%= som(wash.commission_owed_between(month)) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <h2 class="section__title">So'nggi 14 kun — daromad</h2>
    <%= bar_chart(@daily, unit: "so'm") %>

    <h2 class="section__title">Band soatlar (jami)</h2>
    <% if @hourly.any? %>
      <%= bar_chart(@hourly) %>
    <% else %>
      <p class="empty-note">Hali statistika yo'q.</p>
    <% end %>

    <h2 class="section__title">So'nggi bronlar</h2>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Kod</th><th>Moyka</th><th>Mijoz</th><th>Sana</th><th>Holat</th></tr></thead>
        <tbody>
          <% @recent.each do |b| %>
            <tr>
              <td><%= b.code %></td>
              <td><%= b.wash.name %></td>
              <td><%= b.customer_name %></td>
              <td><%= uz_date(b.date) %>, <%= b.slot %></td>
              <td><%= status_badge(b) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
