<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "MoykaGo — Toshkentda avtomoyka bron qilish" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Toshkentdagi eng yaqin avtomoykani toping, vaqtni tanlang va navbatsiz keling. MoykaGo — avtomoyka bron qilish xizmati.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2C12 2 5 10.5 5 15a7 7 0 0 0 14 0c0-4.5-7-13-7-13z' fill='%230891B2'/></svg>">
    <%= stylesheet_link_tag :app %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container site-header__row">
        <%= link_to root_path, class: "logo" do %>
          <span class="logo__drop"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 2C12 2 5 10.5 5 15a7 7 0 0 0 14 0c0-4.5-7-13-7-13z" fill="currentColor"/></svg></span>
          Moyka<em>Go</em>
        <% end %>
        <nav class="site-nav">
          <%= link_to t("nav.washes"), washes_path %>
          <%= link_to t("nav.my_bookings"), lookup_path %>
          <% if current_customer %>
            <%= link_to t("nav.cabinet"), customer_dashboard_path, class: "site-nav__panel" %>
          <% elsif current_user %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "site-nav__panel" %>
            <% elsif current_user.wash %>
              <%= link_to "Panel", panel_bookings_path, class: "site-nav__panel" %>
            <% end %>
          <% else %>
            <%= link_to t("nav.login"), customer_login_path, class: "site-nav__login" %>
            <%= link_to t("nav.staff"), panel_login_path, class: "site-nav__staff" %>
          <% end %>
          <span class="lang-switch">
            <% I18n.available_locales.each do |loc| %>
              <%= link_to loc.to_s.upcase, url_for(request.query_parameters.merge(locale: loc)),
                    class: "lang-switch__item #{'on' if I18n.locale == loc}" %>
            <% end %>
          </span>
        </nav>
      </div>
    </header>

    <% if flash[:notice] %>
      <div class="container"><div class="flash flash--ok"><%= flash[:notice] %></div></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="container"><div class="flash flash--err"><%= flash[:alert] %></div></div>
    <% end %>

    <main>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="site-footer__brand">Moyka<em>Go</em></p>
        <p><%= t("footer.tagline") %></p>
        <p class="site-footer__note"><%= t("footer.payment_note") %></p>
      </div>
    </footer>
  </body>
</html>
