<section class="hero">
  <div class="container hero__inner">
    <p class="hero__eyebrow"><%= t("home.hero_eyebrow", count: @wash_count) %></p>
    <h1><%= t("home.hero_title") %> <span class="hero__accent"><%= t("home.hero_accent") %></span><%= t("home.hero_title_end") %></h1>
    <p class="hero__sub"><%= t("home.hero_sub") %></p>
    <%= form_with url: washes_path, method: :get, class: "hero__search" do %>
      <select name="district" aria-label="<%= t('home.all_districts') %>">
        <option value=""><%= t("home.all_districts") %></option>
        <% Wash::DISTRICTS.each do |d| %>
          <option value="<%= d %>"><%= d %></option>
        <% end %>
      </select>
      <button type="submit" class="btn btn--accent"><%= t("home.find_wash") %></button>
    <% end %>
    <div class="hero__bubbles" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>
  <div class="wave" aria-hidden="true"></div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section__title"><%= t("home.how_it_works") %></h2>
    <div class="steps">
      <div class="step">
        <div class="step__icon"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
        <h3><%= t("home.step1_title") %></h3>
        <p><%= t("home.step1_desc") %></p>
      </div>
      <div class="step">
        <div class="step__icon"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
        <h3><%= t("home.step2_title") %></h3>
        <p><%= t("home.step2_desc") %></p>
      </div>
      <div class="step">
        <div class="step__icon"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.6L20 10l-5.6 1.9L12 17l-1.9-5.1L4 10l6.1-1.4L12 3z"/><path d="M19 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2z"/></svg></div>
        <h3><%= t("home.step3_title") %></h3>
        <p><%= t("home.step3_desc") %></p>
      </div>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="container">
    <div class="section__head">
      <h2 class="section__title"><%= t("home.featured") %></h2>
      <%= link_to t("home.see_all"), washes_path, class: "section__more" %>
    </div>
    <div class="cards">
      <%= render partial: "washes/card", collection: @featured, as: :wash %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section__title"><%= t("home.by_district") %></h2>
    <div class="chips">
      <% Wash::DISTRICTS.each do |d| %>
        <% n = @district_counts[d].to_i %>
        <% if n.positive? %>
          <%= link_to washes_path(district: d), class: "chip" do %>
            <%= d %> <span class="chip__n"><%= n %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
