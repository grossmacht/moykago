<% content_for :title, "#{t('customers.new.title')} — MoykaGo" %>
<section class="section">
  <div class="container container--narrow">
    <h1><%= t("customers.new.title") %></h1>
    <p class="hint"><%= t("customers.new.hint") %></p>
    <%= form_with model: @customer, url: customer_signup_path, class: "login-form" do |f| %>
      <label><%= t("customers.new.name") %>
        <%= f.text_field :name, required: true, autofocus: true %>
      </label>
      <label><%= t("customers.new.phone") %>
        <%= f.telephone_field :phone, required: true, placeholder: "+998 90 123 45 67" %>
      </label>
      <label><%= t("customers.new.password") %>
        <%= f.password_field :password, required: true %>
      </label>
      <label><%= t("customers.new.referral_optional") %>
        <input type="text" name="referral_code" value="<%= params[:ref] %>" placeholder="<%= t('customers.new.referral_placeholder') %>">
      </label>
      <%= f.submit t("customers.new.submit"), class: "btn btn--primary btn--big" %>
    <% end %>
    <p class="hint"><%= t("customers.new.have_account") %> <%= link_to t("customers.new.login"), customer_login_path %></p>
  </div>
</section>
